{
  "name": "state-machine",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "postinstall": "[ ! -d .git ] || lefthook install",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "typecheck": "bun check",
    "test": "bun test --pass-with-no-tests",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2",
    "kill-port-process": "^5.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "lefthook": "^2.2.4",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
