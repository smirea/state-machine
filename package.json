{
  "name": "state-machine",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "[ ! -d .git ] || lefthook install",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "typecheck": "bun check",
    "check:deps": "bun scripts/check-workspace-deps.ts",
    "test": "bun test --pass-with-no-tests",
    "dev": "bunx nx run-many -t dev",
    "build": "bunx nx run-many -t build",
    "graph": "bunx nx graph"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2",
    "kill-port-process": "^5.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "lefthook": "^2.2.4",
    "nx": "^24.1.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
